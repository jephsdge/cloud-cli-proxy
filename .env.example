# PostgreSQL
POSTGRES_DB=cloudproxy
POSTGRES_USER=cloudproxy
POSTGRES_PASSWORD=cloudproxy
POSTGRES_PORT=5433
DATABASE_URL=postgres://cloudproxy:cloudproxy@127.0.0.1:5433/cloudproxy?sslmode=disable

# Control Plane
CONTROL_PLANE_ADDR=127.0.0.1:8090
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_JWT_SECRET=change-this-to-a-random-string-at-least-32-chars

# Logging
LOG_FORMAT=text
LOG_LEVEL=info

# Optional: set to 1400 when managed Docker bridge networks leave through GRE/VXLAN or another lower-MTU path.
CLOUD_CLI_PROXY_NETWORK_MTU=

# Optional: IPv4 /16 CIDR used to derive per-host cloudproxy-egress-* subnets.
# Keep this away from the sing-box TUN address range (default TUN is 172.19.0.1/30).
CLOUD_CLI_PROXY_EGRESS_NETWORK_BASE=172.30.0.0/16

# Optional: runtime Linux identity for newly created worker containers.
# Set these to the host user's values to avoid bind-mounted directories being chowned to 1000:1000.
# Example:
#   CLOUD_CLI_PROXY_WORKER_USER=work
#   CLOUD_CLI_PROXY_WORKER_UID=1008
#   CLOUD_CLI_PROXY_WORKER_GID=1009
# CLOUD_CLI_PROXY_WORKER_HOME is optional; when empty it defaults to /home/${CLOUD_CLI_PROXY_WORKER_USER}.
CLOUD_CLI_PROXY_WORKER_USER=
CLOUD_CLI_PROXY_WORKER_UID=
CLOUD_CLI_PROXY_WORKER_GID=
CLOUD_CLI_PROXY_WORKER_HOME=

# Optional: override only when SSH proxy should login to a different user than CLOUD_CLI_PROXY_WORKER_USER.
SSH_PROXY_CONTAINER_USER=

# Optional: extra apt packages baked into the managed-user image at build time.
# Example for local PostgreSQL + pgvector inside worker:
# CLOUD_CLI_PROXY_WORKER_EXTRA_APT_PACKAGES=postgresql postgresql-contrib postgresql-16-pgvector
CLOUD_CLI_PROXY_WORKER_EXTRA_APT_PACKAGES=
